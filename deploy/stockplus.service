[Unit]
Description=StockPlus - API y frontend
Documentation=file:///opt/stockplus/docs/DESPLIEGUE.md
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=stockplus
Group=stockplus
WorkingDirectory=/opt/stockplus/backend
Environment=NODE_ENV=production
# Ajusta el puerto si cambias PORT en backend/.env
Environment=PORT=5000
# Opcional: directorio de Node instalado con nvm
# Environment=PATH=/home/stockplus/.nvm/versions/node/v24.18.0/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/node src/app.js
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=stockplus
# Limites basicos
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/stockplus/backend

[Install]
WantedBy=multi-user.target
