{
  "name": "stockplus-backend",
  "version": "1.0.0",
  "description": "StockPlus - Backend API con Express.js",
  "main": "src/app.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/app.js",
    "start:prod": "node src/app.js",
    "dev": "nodemon src/app.js",
    "pretest": "node scripts/setup-test-db.js",
    "test": "jest --runInBand --verbose",
    "test:silent": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage",
    "db:setup-test": "node scripts/setup-test-db.js",
    "db:reset-password": "node scripts/reset-password.js",
    "db:create-admin": "node scripts/create-admin.js",
    "db:backup": "node scripts/backup.js"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 30000,
    "roots": [
      "<rootDir>/tests"
    ],
    "testMatch": [
      "**/*.test.js"
    ],
    "setupFiles": [
      "<rootDir>/tests/setup-env.js"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setup-after-env.js"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 50,
        "branches": 40,
        "functions": 50,
        "lines": 50
      }
    }
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.22.3",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.1"
  }
}
