# ============================================
# StockPlus - Variables de entorno del backend
# Copia este archivo como backend/.env y completa
# los valores. Nunca compartas tu .env real.
# ============================================

# PostgreSQL (instalacion local)
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=TU_CONTRASENA_AQUI
PG_DB=stockplus

# Base de datos exclusiva para pruebas automatizadas
PG_DB_TEST=stockplus_test

# PostgreSQL gestionado (Render, Railway, Neon, Supabase).
# Si usas DATABASE_URL, las variables PG_HOST/PG_PORT/PG_USER/PG_PASSWORD/PG_DB
# se ignoran. Activa PG_SSL cuando el proveedor lo exija.
# DATABASE_URL=postgresql://usuario:clave@host:5432/stockplus
PG_SSL=false
PG_SSL_REJECT_UNAUTHORIZED=false
PG_POOL_MAX=20
PG_STATEMENT_TIMEOUT_MS=30000

# Seguridad JWT
# Genera una clave larga y aleatoria, por ejemplo con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# En produccion se rechazan claves de menos de 32 caracteres o predecibles.
JWT_SECRET_KEY=CAMBIA_ESTA_CLAVE_POR_UNA_LARGA_Y_ALEATORIA
JWT_EXPIRES_IN=8h

# Servidor
PORT=5000
# production: sin logs SQL, valida el secreto JWT y sirve la app compilada.
# npm run dev fuerza development para depurar.
NODE_ENV=production

# Proxy inverso (Nginx, Caddy, Render, Railway...). Usa 1 si hay un solo proxy.
TRUST_PROXY=

# Registro publico de vendedores. Desactivalo en internet y crea las cuentas
# con: npm run db:create-admin
ALLOW_REGISTRATION=true

# Limite general de peticiones por IP cada 15 minutos.
API_RATE_LIMIT_MAX=1000

# Origenes permitidos para CORS (opcional, separados por coma).
# En local el frontend se sirve desde el mismo puerto, no es necesario.
CORS_ORIGINS=
